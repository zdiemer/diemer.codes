---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = await getCollection('projects');
const running = projects.filter((p) => p.data.sub === 'running').length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Projects — diemer.codes',
  url: 'https://diemer.codes/projects',
  author: { '@type': 'Person', name: 'Zach Diemer', url: 'https://diemer.codes' },
};
---

<Base
  title="projects · diemer.codes"
  description="Things I build and run: self-hosted services on a home k3s cluster, emulators, bots, and the charts that keep them alive."
  jsonLd={jsonLd}
>
  <section class="proj">
    <div class="prompt">
      <b>zach@diemer.codes</b>:~$ systemctl list-units --type=service --all<span
        class="cursor"
        aria-hidden="true"></span>
    </div>

    <div class="units" role="table" aria-label="Projects">
      <div class="row head" role="row">
        <span role="columnheader">UNIT</span>
        <span role="columnheader">LOAD</span>
        <span role="columnheader">ACTIVE</span>
        <span role="columnheader">SUB</span>
        <span role="columnheader">DESCRIPTION</span>
      </div>
      {
        projects.map((p) => (
          <div class="row" role="row">
            <span class="unit" role="cell">
              {p.data.url ? (
                <a href={p.data.url}>{p.data.id}.service</a>
              ) : (
                <>
                  {p.data.id}.service <i class="priv">[private]</i>
                </>
              )}
            </span>
            <span class="load" role="cell">
              loaded
            </span>
            <span class:list={['active', p.data.active]} role="cell">
              {p.data.active}
            </span>
            <span class:list={['sub', p.data.sub]} role="cell">
              {p.data.sub}
            </span>
            <span class="desc" role="cell">
              {p.data.description}
            </span>
          </div>
        ))
      }
    </div>

    <p class="legend dim">
      {projects.length} loaded units listed. <span class="run">{running} running</span> on the
      cluster; <i>exited</i> shipped and stands; <i>activating</i> is under construction.
      Sources without a link are private repos.
    </p>
  </section>
</Base>

<style>
  .proj {
    padding: 54px 26px 34px;
  }
  .prompt {
    font-size: 12px;
    color: var(--am-dim);
    margin-bottom: 26px;
    overflow-wrap: anywhere;
  }
  .prompt b {
    color: var(--am);
    font-weight: 500;
  }

  .units {
    overflow-x: auto;
    display: grid;
    grid-template-columns: max-content max-content max-content max-content minmax(280px, 1fr);
    column-gap: 22px;
    font-size: 11.5px;
    min-width: 0;
  }
  .row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    padding: 7px 0;
    border-bottom: 1px solid rgba(58, 46, 26, 0.55);
    align-items: baseline;
  }
  .row.head {
    color: var(--am-dim);
    font-size: 10px;
    letter-spacing: 0.12em;
    border-bottom: 1px solid var(--am-line);
  }
  .unit a {
    color: var(--am);
    text-decoration: none;
    border-bottom: 1px dotted var(--am-dim);
    padding-bottom: 1px;
  }
  .unit a:hover {
    color: var(--am-hot);
    border-bottom-color: var(--am);
    text-shadow: 0 0 12px rgba(242, 169, 59, 0.4);
  }
  .priv {
    font-style: normal;
    color: var(--am-dim);
    font-size: 10px;
  }
  .load,
  .desc {
    color: var(--am-dim);
  }
  .active.active,
  .sub.running {
    color: var(--am);
  }
  .sub.running {
    text-shadow: 0 0 10px rgba(242, 169, 59, 0.35);
  }
  .active.activating,
  .sub.start {
    color: var(--am-hot);
  }
  .sub.exited,
  .active.inactive,
  .sub.dead {
    color: var(--am-dim);
  }

  .legend {
    font-size: 10.5px;
    margin-top: 26px;
    max-width: 68ch;
    line-height: 1.9;
  }
  .legend .run {
    color: var(--am);
  }
  .legend i {
    font-style: normal;
    color: var(--am);
  }

  @media (max-width: 720px) {
    .units {
      grid-template-columns: max-content max-content minmax(220px, 1fr);
    }
    .row {
      grid-template-columns: subgrid;
    }
    .load,
    .row.head span:nth-child(2),
    .active,
    .row.head span:nth-child(3) {
      display: none;
    }
  }
</style>
