---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Telemetry from '../components/Telemetry.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d
    .toLocaleDateString('en-US', { month: 'short', day: '2-digit', timeZone: 'UTC' })
    .toLowerCase()
    .replace(',', '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'diemer.codes',
      url: 'https://diemer.codes',
      description: 'Software engineer. Recreational sysadmin.',
      author: { '@id': 'https://diemer.codes/#zach' },
    },
    {
      '@type': 'Person',
      '@id': 'https://diemer.codes/#zach',
      name: 'Zach Diemer',
      url: 'https://diemer.codes',
      email: 'zach@diemer.codes',
      jobTitle: 'Software Engineer',
      sameAs: ['https://github.com/zdiemer', 'https://www.linkedin.com/in/zach-diemer'],
    },
  ],
};
---

<Base jsonLd={jsonLd}>
  <section class="hero">
    <div class="prompt">
      <b>zach@diemer.codes</b>:~$ <span id="typed" data-text="cat motd">cat motd</span><span
        class="cursor"
        aria-hidden="true"></span>
    </div>
    <h1>Software engineer.<br />Recreational sysadmin.</h1>
    <p class="lede">
      I run production-grade infrastructure for a userbase of one. This site is the log:
      Kubernetes on thrift-store silicon, self-hosted finance dashboards, and bots that text me
      when things catch fire. <i>// uptime is a lifestyle</i>
    </p>
  </section>

  <div class="divider" aria-hidden="true">
    <b>&#9484;&#9472;[ ~/writing ]</b>&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;
  </div>

  <section class="ls" aria-label="Posts">
    <table>
      <tbody>
        {
          posts.map((post) => (
            <tr data-filter={`${post.data.title} ${post.id} ${post.data.tags.join(' ')}`}>
              <td class="perm">-rw-r--r--</td>
              <td class="date">{fmt(post.data.date)}</td>
              <td class="name">
                <a href={`/writing/${post.id}`}>{`${post.id}.md`}</a>
              </td>
              <td class="tag">{post.data.tags[0] && <i>{post.data.tags[0]}</i>}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="panels">
    <div class="panel">
      <div class="panel-bar"><span><b>cluster</b> &middot; 5m load</span><span>refresh 30s</span></div>
      <Telemetry />
    </div>
    <div class="panel">
      <div class="panel-bar"><span><b>mugshot.png</b></span><span>dithered 1-bit</span></div>
      <div class="portrait">
        <div class="scanwrap">
          <img
            src="/images/portrait-1bit.png"
            alt="Bayer-dithered 1-bit portrait of Zach Diemer"
            width="112"
            height="140"
          />
          <span class="scanbeam" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 54px 26px 12px;
  }
  .prompt {
    font-size: 12px;
    color: var(--am-dim);
    margin-bottom: 14px;
  }
  .prompt b {
    color: var(--am);
    font-weight: 500;
  }
  .hero h1 {
    font-size: clamp(30px, 4.6vw, 52px);
    line-height: 1.08;
    margin: 0 0 16px;
  }
  .lede {
    font-size: 12.5px;
    line-height: 1.8;
    max-width: 58ch;
    margin: 0;
  }
  .lede i {
    font-style: normal;
    color: var(--am-dim);
  }

  .divider {
    padding: 26px 26px 8px;
    color: var(--am-dim);
    font-family: 'Departure Mono', monospace;
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
  }
  .divider b {
    color: var(--am);
    font-weight: 400;
  }

  .ls {
    padding: 4px 26px 8px;
  }
  .ls table {
    border-collapse: collapse;
    width: 100%;
  }
  .ls td {
    padding: 8px 18px 8px 0;
    font-size: 11.5px;
    vertical-align: baseline;
    white-space: nowrap;
  }
  .perm,
  .date {
    color: var(--am-dim);
    font-size: 10.5px;
  }
  .name {
    white-space: normal;
  }
  .name a {
    color: var(--am);
    text-decoration: none;
    border-bottom: 1px dotted var(--am-dim);
    padding-bottom: 1px;
  }
  .name a:hover,
  .name a:active {
    color: var(--am-hot);
    border-bottom-color: var(--am);
    text-shadow: 0 0 12px rgba(242, 169, 59, 0.4);
  }
  .tag {
    color: var(--am-dim);
    font-size: 10px;
  }
  .tag i {
    font-style: normal;
    border: 1px solid var(--am-line);
    padding: 2px 7px;
  }

  .panels {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 18px;
    padding: 26px;
  }
  @media (max-width: 820px) {
    .panels {
      grid-template-columns: 1fr;
    }
  }
  .panel {
    border: 1px solid var(--am-line);
    background: var(--panel);
  }
  .panel-bar {
    display: flex;
    justify-content: space-between;
    padding: 8px 14px;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--am-dim);
    border-bottom: 1px solid var(--am-line);
  }
  .panel-bar b {
    color: var(--am);
    font-weight: 500;
  }
  .portrait {
    display: flex;
    justify-content: center;
    padding: 10px 0;
  }
  .scanwrap {
    position: relative;
    overflow: hidden;
    line-height: 0;
  }
  .portrait img {
    height: 170px;
    width: auto;
    image-rendering: pixelated;
  }
  /* CRT rescan: a bright beam sweeps the portrait on hover / tap. */
  .scanbeam {
    position: absolute;
    left: 0;
    right: 0;
    top: -30%;
    height: 26%;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(255, 223, 168, 0.28) 45%,
      rgba(255, 223, 168, 0.08) 55%,
      transparent
    );
    opacity: 0;
    pointer-events: none;
  }
  .scanwrap:hover .scanbeam,
  .scanwrap:active .scanbeam {
    opacity: 1;
    animation: rescan 1.1s linear infinite;
  }
  @keyframes rescan {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(520%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scanwrap:hover .scanbeam,
    .scanwrap:active .scanbeam {
      animation: none;
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 40px 16px 8px;
    }
    .divider {
      padding: 24px 16px 8px;
    }
    .ls {
      padding: 4px 16px 8px;
    }
    .perm {
      display: none;
    }
    .panels {
      padding: 20px 16px;
      gap: 14px;
    }
  }
</style>

<script>
  // Type the hero command once per session; instant for return visits,
  // reduced-motion users, and crawlers (the text is server-rendered).
  function typeMotd() {
    const el = document.getElementById('typed');
    if (!el || el.dataset.done) return;
    el.dataset.done = '1';
    const text = el.dataset.text || '';
    if (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      sessionStorage.getItem('motd-typed')
    ) {
      el.textContent = text;
      return;
    }
    sessionStorage.setItem('motd-typed', '1');
    el.textContent = '';
    let i = 0;
    const timer = setInterval(() => {
      if (!el.isConnected || i >= text.length) {
        clearInterval(timer);
        if (el.isConnected) el.textContent = text;
        return;
      }
      el.textContent += text[i++];
    }, 55);
  }
  typeMotd();
  document.addEventListener('astro:page-load', typeMotd);
</script>
