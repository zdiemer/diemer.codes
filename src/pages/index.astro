---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Telemetry from '../components/Telemetry.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d
    .toLocaleDateString('en-US', { month: 'short', day: '2-digit', timeZone: 'UTC' })
    .toLowerCase()
    .replace(',', '');
---

<Base>
  <section class="hero">
    <div class="prompt">
      <b>zach@diemer.codes</b>:~$ cat motd<span class="cursor" aria-hidden="true"></span>
    </div>
    <h1>Software engineer.<br />Recreational sysadmin.</h1>
    <p class="lede">
      I run production-grade infrastructure for a userbase of one. This site is the log:
      Kubernetes on thrift-store silicon, self-hosted finance dashboards, and bots that text me
      when things catch fire. <i>// uptime is a lifestyle</i>
    </p>
  </section>

  <div class="divider" aria-hidden="true">
    <b>&#9484;&#9472;[ ~/writing ]</b>&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;
  </div>

  <section class="ls" aria-label="Posts">
    <table>
      <tbody>
        {
          posts.map((post) => (
            <tr>
              <td class="perm">-rw-r--r--</td>
              <td class="date">{fmt(post.data.date)}</td>
              <td class="name">
                <a href={`/writing/${post.id}`}>{`${post.id}.md`}</a>
              </td>
              <td class="tag">{post.data.tags[0] && <i>{post.data.tags[0]}</i>}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="panels">
    <div class="panel">
      <div class="panel-bar"><span><b>cluster</b> &middot; 5m load</span><span>refresh 30s</span></div>
      <Telemetry />
    </div>
    <div class="panel">
      <div class="panel-bar"><span><b>mugshot.png</b></span><span>dithered 1-bit</span></div>
      <div class="portrait">
        <img
          src="/images/portrait-1bit.png"
          alt="Bayer-dithered 1-bit portrait of Zach Diemer"
          width="112"
          height="140"
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 54px 26px 12px;
  }
  .prompt {
    font-size: 12px;
    color: var(--am-dim);
    margin-bottom: 14px;
  }
  .prompt b {
    color: var(--am);
    font-weight: 500;
  }
  .hero h1 {
    font-size: clamp(30px, 4.6vw, 52px);
    line-height: 1.08;
    margin: 0 0 16px;
  }
  .lede {
    font-size: 12.5px;
    line-height: 1.8;
    max-width: 58ch;
    margin: 0;
  }
  .lede i {
    font-style: normal;
    color: var(--am-dim);
  }

  .divider {
    padding: 26px 26px 8px;
    color: var(--am-dim);
    font-family: 'Departure Mono', monospace;
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
  }
  .divider b {
    color: var(--am);
    font-weight: 400;
  }

  .ls {
    padding: 4px 26px 8px;
    overflow-x: auto;
  }
  .ls table {
    border-collapse: collapse;
    width: 100%;
    min-width: 640px;
  }
  .ls td {
    padding: 8px 18px 8px 0;
    font-size: 11.5px;
    vertical-align: baseline;
    white-space: nowrap;
  }
  .perm,
  .date {
    color: var(--am-dim);
    font-size: 10.5px;
  }
  .name {
    white-space: normal;
  }
  .name a {
    color: var(--am);
    text-decoration: none;
    border-bottom: 1px dotted var(--am-dim);
    padding-bottom: 1px;
  }
  .name a:hover {
    color: var(--am-hot);
    border-bottom-color: var(--am);
    text-shadow: 0 0 12px rgba(242, 169, 59, 0.4);
  }
  .tag {
    color: var(--am-dim);
    font-size: 10px;
  }
  .tag i {
    font-style: normal;
    border: 1px solid var(--am-line);
    padding: 2px 7px;
  }

  .panels {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 18px;
    padding: 26px;
  }
  @media (max-width: 820px) {
    .panels {
      grid-template-columns: 1fr;
    }
  }
  .panel {
    border: 1px solid var(--am-line);
    background: var(--panel);
  }
  .panel-bar {
    display: flex;
    justify-content: space-between;
    padding: 8px 14px;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--am-dim);
    border-bottom: 1px solid var(--am-line);
  }
  .panel-bar b {
    color: var(--am);
    font-weight: 500;
  }
  .portrait {
    display: flex;
    justify-content: center;
    padding: 10px 0;
  }
  .portrait img {
    height: 170px;
    width: auto;
    image-rendering: pixelated;
  }
</style>
