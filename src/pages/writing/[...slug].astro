---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const date = post.data.date.toISOString().slice(0, 10);
const url = `https://diemer.codes/writing/${post.id}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  keywords: post.data.tags.join(', '),
  url,
  mainEntityOfPage: url,
  image: 'https://diemer.codes/og.png',
  author: {
    '@type': 'Person',
    name: 'Zach Diemer',
    url: 'https://diemer.codes',
  },
};
---

<Base
  title={`${post.data.title} · diemer.codes`}
  description={post.data.description}
  ogType="article"
  publishedDate={post.data.date}
  tags={post.data.tags}
  jsonLd={jsonLd}
>
  <article class="post">
    <div class="prompt">
      <b>zach@diemer.codes</b>:~$ cat writing/{post.id}.md
    </div>
    <h1>{post.data.title}</h1>
    <div class="meta">
      <time datetime={date}>{date}</time>
      {post.data.tags.map((tag) => <span class="chip">{tag}</span>)}
    </div>
    <div class="prose">
      <Content />
    </div>
    <div class="endcap" aria-hidden="true">&#9492;&#9472;&#9472; EOF</div>
  </article>
</Base>

<style>
  .post {
    padding: 44px 26px 34px;
    max-width: 780px;
  }
  .prompt {
    font-size: 12px;
    color: var(--am-dim);
    margin-bottom: 18px;
    overflow-wrap: anywhere;
  }
  .prompt b {
    color: var(--am);
    font-weight: 500;
  }
  h1 {
    font-size: clamp(24px, 3.6vw, 38px);
    line-height: 1.15;
    margin: 0 0 12px;
  }
  .meta {
    display: flex;
    gap: 10px;
    align-items: baseline;
    color: var(--am-dim);
    font-size: 10.5px;
    margin-bottom: 30px;
  }
  .chip {
    border: 1px solid var(--am-line);
    padding: 2px 7px;
    font-size: 10px;
  }
  .endcap {
    margin-top: 40px;
    color: var(--am-dim);
    font-family: 'Departure Mono', monospace;
    font-size: 13px;
  }
</style>

<style is:global>
  .prose {
    font-size: 12.5px;
    line-height: 2;
  }
  .prose p {
    margin: 0 0 18px;
  }
  .prose h2,
  .prose h3 {
    margin: 34px 0 14px;
    font-size: 17px;
  }
  .prose h3 {
    font-size: 14px;
  }
  .prose a {
    color: var(--am);
    text-decoration: none;
    border-bottom: 1px dotted var(--am-dim);
  }
  .prose a:hover {
    color: var(--am-hot);
    border-bottom-color: var(--am);
  }
  .prose ul,
  .prose ol {
    padding-left: 1.4em;
    margin: 0 0 18px;
  }
  .prose li {
    margin-bottom: 6px;
  }
  .prose li::marker {
    color: var(--am-dim);
  }
  .prose blockquote {
    margin: 0 0 18px;
    padding: 2px 0 2px 16px;
    border-left: 2px solid var(--am-line);
    color: var(--am-dim);
  }
  .prose code {
    font-family: 'Martian Mono', monospace;
    font-size: 11.5px;
    color: var(--am-hot);
  }
  .prose pre {
    border: 1px solid var(--am-line);
    background: var(--panel) !important;
    padding: 14px 16px;
    overflow-x: auto;
    margin: 0 0 18px;
  }
  .prose pre code {
    color: inherit;
    font-size: 11px;
    line-height: 1.7;
  }
  .prose img {
    max-width: 100%;
    border: 1px solid var(--am-line);
  }
  .prose hr {
    border: none;
    border-top: 1px solid var(--am-line);
    margin: 28px 0;
  }
  .prose table {
    border-collapse: collapse;
    margin: 0 0 18px;
  }
  .prose th,
  .prose td {
    border: 1px solid var(--am-line);
    padding: 6px 12px;
    font-size: 11.5px;
  }
</style>
