---
import Statusline from '../components/Statusline.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  publishedDate?: Date;
  tags?: string[];
  jsonLd?: object;
}

const {
  title = 'diemer.codes',
  description = 'Software engineer. Recreational sysadmin. Notes from a homelab that takes itself slightly too seriously.',
  ogType = 'website',
  publishedDate,
  tags = [],
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Zach Diemer" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#14100a" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="diemer.codes" href="/rss.xml" />

    <meta property="og:site_name" content="diemer.codes" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="diemer.codes — amber terminal with a 1-bit dithered portrait" />
    {
      ogType === 'article' && publishedDate && (
        <meta property="article:published_time" content={publishedDate.toISOString()} />
      )
    }
    {ogType === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="wrap">
      <Statusline />
      <slot />
      <footer class="foot">
        <span class="dim"
          ><b>:q</b> <a href="/">home</a>&ensp;<b>:e</b> <a href="/projects">projects</a>&ensp;<b
            >:w</b
          > <a href="/rss.xml">subscribe</a></span
        >
        <span class="dim">
          <a href="/rss.xml">rss.xml</a> &middot;
          <a href="https://github.com/zdiemer">github/zdiemer</a> &middot;
          <a href="mailto:zach@diemer.codes">mail</a>
        </span>
      </footer>
    </div>
  </body>
</html>

<style>
  .foot {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    padding: 14px 26px 18px;
    border-top: 1px solid var(--am-line);
    font-size: 10.5px;
    flex-wrap: wrap;
  }
  .foot b {
    color: var(--am);
    font-weight: 500;
  }
  .foot a {
    color: var(--am);
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--am-hot);
  }
</style>
