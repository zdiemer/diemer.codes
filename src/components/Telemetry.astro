<canvas id="cv-tele" width="1000" height="340"></canvas>

<style>
  canvas {
    display: block;
    width: 100%;
    height: 170px;
  }
</style>

<script>
  function prng(seed: number) {
    return function () {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  const c = document.getElementById('cv-tele') as HTMLCanvasElement | null;
  if (c) {
    const g = c.getContext('2d')!;
    const w = c.width;
    const h = c.height;
    g.strokeStyle = 'rgba(242,169,59,0.14)';
    g.lineWidth = 1;
    for (let y = h - 30; y > 20; y -= 52) {
      g.beginPath();
      g.moveTo(24, y);
      g.lineTo(w - 24, y);
      g.stroke();
    }
    function series(seed: number, amp: number, base: number, color: string, lw: number, glow: boolean) {
      const rr = prng(seed);
      const pts: [number, number][] = [];
      let v = base;
      for (let x = 0; x <= 56; x++) {
        v += (rr() - 0.5) * amp;
        v = Math.max(base - amp * 2.2, Math.min(base + amp * 2.6, v));
        pts.push([24 + (x / 56) * (w - 48), v]);
      }
      g.save();
      if (glow) {
        g.shadowColor = 'rgba(242,169,59,0.55)';
        g.shadowBlur = 12;
      }
      g.strokeStyle = color;
      g.lineWidth = lw;
      g.beginPath();
      pts.forEach((p, i) => {
        if (i === 0) g.moveTo(p[0], p[1]);
        else {
          g.lineTo(p[0], pts[i - 1][1]);
          g.lineTo(p[0], p[1]);
        }
      });
      g.stroke();
      g.restore();
      const last = pts[pts.length - 1];
      g.fillStyle = color;
      g.fillRect(last[0] - 3, last[1] - 3, 6, 6);
    }
    series(41, 26, h * 0.62, 'rgba(147,112,47,0.9)', 1.5, false);
    series(97, 30, h * 0.42, '#F2A93B', 2, true);
    g.fillStyle = 'rgba(242,169,59,0.75)';
    g.font = '16px "Martian Mono", monospace';
    g.fillText('0.42', w - 78, h * 0.42 - 14);
  }
</script>
